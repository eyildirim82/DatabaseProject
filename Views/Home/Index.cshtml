@model DatabaseProject.Models.DashboardStats
@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-3">
                <i class="bi bi-speedometer2 me-2"></i>Ana Sayfa
            </h2>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Özet İstatistikler -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Riskli Müşteri Sayısı</h6>
                            <h3 class="mb-0">@Model.RiskyCustomerCount</h3>
                        </div>
                        <div class="text-danger" style="font-size: 2.5rem;">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Toplam Alacak</h6>
                            <h3 class="mb-0">@Model.TotalReceivables.ToString("N2") ₺</h3>
                        </div>
                        <div class="text-info" style="font-size: 2.5rem;">
                            <i class="bi bi-currency-exchange"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Vadesi Geçen Çekler</h6>
                            <h3 class="mb-0">@ViewBag.OverdueChequesCount</h3>
                        </div>
                        <div class="text-warning" style="font-size: 2.5rem;">
                            <i class="bi bi-receipt-cutoff"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hızlı Erişim -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-lightning-fill me-2"></i>Hızlı Erişim
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-outline-primary w-100">
                                <i class="bi bi-speedometer2 me-2"></i>Detaylı Dashboard
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-info w-100">
                                <i class="bi bi-people-fill me-2"></i>Müşteriler
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-controller="Transaction" asp-action="Create" class="btn btn-outline-success w-100">
                                <i class="bi bi-plus-circle me-2"></i>Yeni İşlem
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-controller="Cheque" asp-action="Index" class="btn btn-outline-warning w-100">
                                <i class="bi bi-receipt-cutoff me-2"></i>Çekler
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
