@model IEnumerable<DatabaseProject.Models.Transaction>
@{
    ViewData["Title"] = "İşlem Listesi";
    int? customerId = ViewBag.CustomerId;
    DateTime? startDate = ViewBag.StartDate;
    DateTime? endDate = ViewBag.EndDate;
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">
                    <i class="bi bi-list-ul me-2"></i>İşlem Listesi
                </h2>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>Yeni İşlem Ekle
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filtreleme -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label for="customerId" class="form-label">Müşteri</label>
                        <select class="form-select" id="customerId" name="customerId">
                            <option value="">Tüm Müşteriler</option>
                            @if (ViewBag.Customers != null)
                            {
                                @foreach (var item in (SelectList)ViewBag.Customers)
                                {
                                    <option value="@item.Value" selected="@(item.Value == customerId?.ToString())">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="startDate" class="form-label">Başlangıç Tarihi</label>
                        <input type="date" class="form-control" id="startDate" name="startDate" value="@(startDate?.ToString("yyyy-MM-dd") ?? "")">
                    </div>
                    <div class="col-md-3">
                        <label for="endDate" class="form-label">Bitiş Tarihi</label>
                        <input type="date" class="form-control" id="endDate" name="endDate" value="@(endDate?.ToString("yyyy-MM-dd") ?? "")">
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="bi bi-funnel me-1"></i>Filtrele
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i>Temizle
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Transaction Listesi -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-table me-2"></i>İşlem Listesi (@Model.Count())
            </h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Tarih</th>
                                <th>Müşteri</th>
                                <th>Ödeme Yöntemi</th>
                                <th>Banka</th>
                                <th class="text-end">Tutar</th>
                                <th>Açıklama</th>
                                <th>Oluşturan</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var transaction in Model)
                            {
                                <tr>
                                    <td>@transaction.TransactionID</td>
                                    <td>@transaction.TransactionDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        <a asp-controller="Customer" asp-action="Details" asp-route-id="@transaction.CustomerID">
                                            @transaction.CompanyName
                                        </a>
                                    </td>
                                    <td>@transaction.MethodName</td>
                                    <td>@(transaction.BankName ?? "-")</td>
                                    <td class="text-end">
                                        <span class="@(transaction.Amount < 0 ? "text-danger" : "text-success")">
                                            @transaction.Amount.ToString("N2") ₺
                                        </span>
                                    </td>
                                    <td>
                                        <div style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@transaction.Description">
                                            @(transaction.Description ?? "-")
                                        </div>
                                    </td>
                                    <td>@transaction.FullName</td>
                                    <td>
                                        @if (transaction.Amount > 0) // Sadece pozitif transaction'lar iptal edilebilir
                                        {
                                            <form asp-action="Reverse" asp-route-id="@transaction.TransactionID" method="post" class="d-inline" onsubmit="return confirm('Bu işlemi iptal etmek istediğinize emin misiniz? Tersine çevrilmiş yeni bir işlem oluşturulacak.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-x-circle"></i> İptal Et
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">İptal edilemez</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>Henüz işlem kaydı bulunmamaktadır.
                </div>
            }
        </div>
    </div>
</div>

<style>
    .table th { font-weight: 600; white-space: nowrap; }
    .table td { vertical-align: middle; }
</style>
