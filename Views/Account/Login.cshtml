@model DatabaseProject.Models.UserLoginModel

@{
    Layout = null; /* Login sayfasında genel layout kullanmayalım */
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Giriş Yap - Distributor Finance</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-4">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white text-center">
                        <h4>Sistem Girişi</h4>
                    </div>
                    <div class="card-body">
                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger">@ViewBag.Error</div>
                        }

                        <form method="post" asp-action="Login">
                            <div class="mb-3">
                                <label>Kullanıcı Adı</label>
                                <input type="text" asp-for="Username" class="form-control" required />
                            </div>
                            <div class="mb-3">
                                <label>Şifre</label>
                                <input type="password" asp-for="Password" class="form-control" required />
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>
                        </form>
                    </div>
                </div>
                <div class="text-center mt-3 text-muted">
                    <small>CSE3055 Project Step #4</small>
                </div>
            </div>
        </div>
    </div>
</body>
</html>