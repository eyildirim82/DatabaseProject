@{
    ViewData["Title"] = "Şifre Değiştir";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-key me-2"></i>Şifre Değiştir
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-circle me-2"></i>@ViewBag.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="currentPassword" class="form-label">
                                <i class="bi bi-lock me-1"></i>Mevcut Şifre <span class="text-danger">*</span>
                            </label>
                            <input type="password" class="form-control" id="currentPassword" name="currentPassword" required autocomplete="current-password">
                        </div>

                        <div class="mb-3">
                            <label for="newPassword" class="form-label">
                                <i class="bi bi-key me-1"></i>Yeni Şifre <span class="text-danger">*</span>
                            </label>
                            <input type="password" class="form-control" id="newPassword" name="newPassword" required autocomplete="new-password" minlength="6">
                            <div class="form-text">En az 6 karakter olmalıdır.</div>
                        </div>

                        <div class="mb-4">
                            <label for="confirmPassword" class="form-label">
                                <i class="bi bi-key-fill me-1"></i>Yeni Şifre (Tekrar) <span class="text-danger">*</span>
                            </label>
                            <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required autocomplete="new-password" minlength="6">
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>İptal
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i>Şifreyi Değiştir
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card mt-4 border-info">
                <div class="card-header bg-light">
                    <i class="bi bi-info-circle me-2"></i>Bilgi
                </div>
                <div class="card-body small">
                    <ul class="mb-0">
                        <li>Şifre değiştirdikten sonra tekrar giriş yapmanız gerekecektir.</li>
                        <li>Yeni şifreniz en az 6 karakter olmalıdır.</li>
                        <li>Güvenliğiniz için güçlü bir şifre seçin.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Client-side validation: Şifre eşleşme kontrolü
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.querySelector('form');
        const newPassword = document.getElementById('newPassword');
        const confirmPassword = document.getElementById('confirmPassword');

        form.addEventListener('submit', function(e) {
            if (newPassword.value !== confirmPassword.value) {
                e.preventDefault();
                alert('Yeni şifre ve şifre tekrarı eşleşmiyor!');
                confirmPassword.focus();
                return false;
            }
        });
    });
</script>

<style>
    .form-label {
        font-weight: 600;
    }
    .text-danger {
        color: #dc3545 !important;
    }
</style>
