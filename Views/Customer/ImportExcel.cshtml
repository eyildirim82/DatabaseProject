@model DatabaseProject.Models.ImportBatchViewModel
@{
    ViewData["Title"] = "Excel Mutabakat Modülü";
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div data-tempdata-success style="display: none;">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div data-tempdata-error style="display: none;">@TempData["ErrorMessage"]</div>
    }

    <div class="row">
        <div class="col-12">
            <!-- Dosya Yükleme Formu -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-file-earmark-excel me-2"></i>Cari Ekstre Dosyası Yükle
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="ImportExcel" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-3">
                            <label for="file" class="form-label">
                                <i class="bi bi-file-earmark-spreadsheet me-1"></i>Excel Dosyası Seçin
                            </label>
                            <input type="file" class="form-control form-control-lg" id="file" name="file" 
                                   accept=".txt,.xlsx,.xls,.csv" required />
                            <div class="form-text">
                                Desteklenen formatlar: .txt, .xlsx, .xls, .csv<br />
                                Dosya adı formatı: TopluCariEkstreRaporu_yyyyMMddHHmmss.xlsx
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Geri Dön
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-upload me-1"></i>Dosyayı Yükle
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- İstatistikler -->
            @if (Model.Statistics != null)
            {
                @await Html.PartialAsync("_BatchStatistics", Model.Statistics)
            }

            <!-- Filtreleme Formu -->
            @await Html.PartialAsync("_BatchFilters", Model)

            <!-- Geçmiş Yüklemeler Tablosu -->
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-clock-history me-2"></i>Geçmiş Yüklemeler
                    </h5>
                    <div>
                        <a asp-action="ExportHistory" 
                           asp-route-format="csv"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-fileNameFilter="@Model.FileNameFilter"
                           asp-route-startDate="@Model.StartDate"
                           asp-route-endDate="@Model.EndDate"
                           class="btn btn-sm btn-light">
                            <i class="bi bi-file-earmark-spreadsheet me-1"></i>CSV İndir
                        </a>
                        <a asp-action="ExportHistory" 
                           asp-route-format="excel"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-fileNameFilter="@Model.FileNameFilter"
                           asp-route-startDate="@Model.StartDate"
                           asp-route-endDate="@Model.EndDate"
                           class="btn btn-sm btn-light">
                            <i class="bi bi-file-earmark-excel me-1"></i>Excel İndir
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Batches != null && Model.Batches.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>
                                            <a asp-action="ImportExcel" 
                                               asp-route-statusFilter="@Model.StatusFilter"
                                               asp-route-fileNameFilter="@Model.FileNameFilter"
                                               asp-route-startDate="@Model.StartDate"
                                               asp-route-endDate="@Model.EndDate"
                                               asp-route-page="@Model.PageNumber"
                                               asp-route-pageSize="@Model.PageSize"
                                               asp-route-sortBy="BatchID"
                                               asp-route-sortDirection="@(Model.SortBy == "BatchID" && Model.SortDirection == "ASC" ? "DESC" : "ASC")"
                                               class="text-decoration-none text-dark">
                                                Batch ID
                                                @if (Model.SortBy == "BatchID")
                                                {
                                                    <i class="bi bi-arrow-@(Model.SortDirection == "ASC" ? "up" : "down")"></i>
                                                }
                                            </a>
                                        </th>
                                        <th>
                                            <a asp-action="ImportExcel" 
                                               asp-route-statusFilter="@Model.StatusFilter"
                                               asp-route-fileNameFilter="@Model.FileNameFilter"
                                               asp-route-startDate="@Model.StartDate"
                                               asp-route-endDate="@Model.EndDate"
                                               asp-route-page="@Model.PageNumber"
                                               asp-route-pageSize="@Model.PageSize"
                                               asp-route-sortBy="FileName"
                                               asp-route-sortDirection="@(Model.SortBy == "FileName" && Model.SortDirection == "ASC" ? "DESC" : "ASC")"
                                               class="text-decoration-none text-dark">
                                                Dosya Adı
                                                @if (Model.SortBy == "FileName")
                                                {
                                                    <i class="bi bi-arrow-@(Model.SortDirection == "ASC" ? "up" : "down")"></i>
                                                }
                                            </a>
                                        </th>
                                        <th>
                                            <a asp-action="ImportExcel" 
                                               asp-route-statusFilter="@Model.StatusFilter"
                                               asp-route-fileNameFilter="@Model.FileNameFilter"
                                               asp-route-startDate="@Model.StartDate"
                                               asp-route-endDate="@Model.EndDate"
                                               asp-route-page="@Model.PageNumber"
                                               asp-route-pageSize="@Model.PageSize"
                                               asp-route-sortBy="FileTimestamp"
                                               asp-route-sortDirection="@(Model.SortBy == "FileTimestamp" && Model.SortDirection == "ASC" ? "DESC" : "ASC")"
                                               class="text-decoration-none text-dark">
                                                Dosya Tarihi
                                                @if (Model.SortBy == "FileTimestamp")
                                                {
                                                    <i class="bi bi-arrow-@(Model.SortDirection == "ASC" ? "up" : "down")"></i>
                                                }
                                            </a>
                                        </th>
                                        <th>
                                            <a asp-action="ImportExcel" 
                                               asp-route-statusFilter="@Model.StatusFilter"
                                               asp-route-fileNameFilter="@Model.FileNameFilter"
                                               asp-route-startDate="@Model.StartDate"
                                               asp-route-endDate="@Model.EndDate"
                                               asp-route-page="@Model.PageNumber"
                                               asp-route-pageSize="@Model.PageSize"
                                               asp-route-sortBy="UploadDate"
                                               asp-route-sortDirection="@(Model.SortBy == "UploadDate" && Model.SortDirection == "ASC" ? "DESC" : "ASC")"
                                               class="text-decoration-none text-dark">
                                                Yükleme Tarihi
                                                @if (Model.SortBy == "UploadDate")
                                                {
                                                    <i class="bi bi-arrow-@(Model.SortDirection == "ASC" ? "up" : "down")"></i>
                                                }
                                            </a>
                                        </th>
                                        <th>
                                            <a asp-action="ImportExcel" 
                                               asp-route-statusFilter="@Model.StatusFilter"
                                               asp-route-fileNameFilter="@Model.FileNameFilter"
                                               asp-route-startDate="@Model.StartDate"
                                               asp-route-endDate="@Model.EndDate"
                                               asp-route-page="@Model.PageNumber"
                                               asp-route-pageSize="@Model.PageSize"
                                               asp-route-sortBy="TotalRecords"
                                               asp-route-sortDirection="@(Model.SortBy == "TotalRecords" && Model.SortDirection == "ASC" ? "DESC" : "ASC")"
                                               class="text-decoration-none text-dark">
                                                Kayıt Sayısı
                                                @if (Model.SortBy == "TotalRecords")
                                                {
                                                    <i class="bi bi-arrow-@(Model.SortDirection == "ASC" ? "up" : "down")"></i>
                                                }
                                            </a>
                                        </th>
                                        <th>
                                            <a asp-action="ImportExcel" 
                                               asp-route-statusFilter="@Model.StatusFilter"
                                               asp-route-fileNameFilter="@Model.FileNameFilter"
                                               asp-route-startDate="@Model.StartDate"
                                               asp-route-endDate="@Model.EndDate"
                                               asp-route-page="@Model.PageNumber"
                                               asp-route-pageSize="@Model.PageSize"
                                               asp-route-sortBy="Status"
                                               asp-route-sortDirection="@(Model.SortBy == "Status" && Model.SortDirection == "ASC" ? "DESC" : "ASC")"
                                               class="text-decoration-none text-dark">
                                                Durum
                                                @if (Model.SortBy == "Status")
                                                {
                                                    <i class="bi bi-arrow-@(Model.SortDirection == "ASC" ? "up" : "down")"></i>
                                                }
                                            </a>
                                        </th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var batch in Model.Batches)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-action="BatchDetails" asp-route-id="@batch.BatchID" class="text-primary text-decoration-none fw-bold">
                                                    @batch.BatchID
                                                </a>
                                            </td>
                                            <td>@batch.FileName</td>
                                            <td>@batch.FileTimestamp.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>@batch.UploadDate.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>@batch.TotalRecords</td>
                                            <td>
                                                @{
                                                    string badgeClass = batch.Status switch
                                                    {
                                                        "Processed" => "bg-success",
                                                        "Pending" => "bg-warning text-dark",
                                                        "Rejected" => "bg-danger",
                                                        _ => "bg-secondary"
                                                    };
                                                }
                                                <span class="badge @badgeClass">@batch.Status</span>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    @if (batch.Status == "Pending")
                                                    {
                                                        <form asp-action="UpdateBatchStatus" method="post" class="d-inline" onsubmit="return confirm('Bu batch\'i iptal etmek istediğinizden emin misiniz?');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="batchId" value="@batch.BatchID" />
                                                            <input type="hidden" name="status" value="Rejected" />
                                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="İptal Et">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    <form asp-action="DeleteBatch" method="post" class="d-inline" onsubmit="return confirm('Bu batch\'i silmek istediğinizden emin misiniz? Bu işlem geri alınamaz!');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="batchId" value="@batch.BatchID" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Sil">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Sayfalama -->
                        @if (Model.TotalPages > 1)
                        {
                            <nav aria-label="Sayfa navigasyonu">
                                <ul class="pagination justify-content-center">
                                    <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                        <a class="page-link" 
                                           asp-action="ImportExcel"
                                           asp-route-statusFilter="@Model.StatusFilter"
                                           asp-route-fileNameFilter="@Model.FileNameFilter"
                                           asp-route-startDate="@Model.StartDate"
                                           asp-route-endDate="@Model.EndDate"
                                           asp-route-page="@(Model.PageNumber - 1)"
                                           asp-route-pageSize="@Model.PageSize"
                                           asp-route-sortBy="@Model.SortBy"
                                           asp-route-sortDirection="@Model.SortDirection">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>
                                    
                                    @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                                    {
                                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                            <a class="page-link" 
                                               asp-action="ImportExcel"
                                               asp-route-statusFilter="@Model.StatusFilter"
                                               asp-route-fileNameFilter="@Model.FileNameFilter"
                                               asp-route-startDate="@Model.StartDate"
                                               asp-route-endDate="@Model.EndDate"
                                               asp-route-page="@i"
                                               asp-route-pageSize="@Model.PageSize"
                                               asp-route-sortBy="@Model.SortBy"
                                               asp-route-sortDirection="@Model.SortDirection">
                                                @i
                                            </a>
                                        </li>
                                    }
                                    
                                    <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                        <a class="page-link" 
                                           asp-action="ImportExcel"
                                           asp-route-statusFilter="@Model.StatusFilter"
                                           asp-route-fileNameFilter="@Model.FileNameFilter"
                                           asp-route-startDate="@Model.StartDate"
                                           asp-route-endDate="@Model.EndDate"
                                           asp-route-page="@(Model.PageNumber + 1)"
                                           asp-route-pageSize="@Model.PageSize"
                                           asp-route-sortBy="@Model.SortBy"
                                           asp-route-sortDirection="@Model.SortDirection">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                            
                            <div class="text-center mt-2">
                                <small class="text-muted">
                                    Toplam @Model.TotalRecords kayıt bulundu. 
                                    Sayfa @Model.PageNumber / @Model.TotalPages
                                    <select name="pageSize" class="form-select form-select-sm d-inline-block w-auto ms-2" onchange="changePageSize(this.value)">
                                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                                        <option value="100" selected="@(Model.PageSize == 100)">100</option>
                                    </select>
                                    kayıt göster
                                </small>
                            </div>
                        }
                        else
                        {
                            <div class="text-center mt-2">
                                <small class="text-muted">Toplam @Model.TotalRecords kayıt bulundu.</small>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="bi bi-info-circle me-2"></i>Henüz yüklenmiş dosya bulunmamaktadır.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .table th {
        background-color: #f8f9fa;
        font-weight: 600;
        white-space: nowrap;
    }
    .table td {
        vertical-align: middle;
    }
    .table th a {
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .table tbody tr:hover {
        background-color: #f8f9fa;
    }
</style>

<script>
    function changePageSize(pageSize) {
        const url = new URL(window.location.href);
        url.searchParams.set('pageSize', pageSize);
        url.searchParams.set('page', '1');
        window.location.href = url.toString();
    }
</script>
