@model DatabaseProject.Models.ImportBatchViewModel
@{
    ViewData["Title"] = "Excel/Rapor Import (Pipeline)";
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-file-earmark-excel me-2"></i>TopluCariEkstreRaporu Yükle
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-primary mb-4">
                        <i class="bi bi-magic me-2"></i>
                        <strong>Otomatik Pipeline!</strong>
                        <hr class="my-2" />
                        <small>
                            Bu özellik <strong>TopluCariEkstreRaporu</strong> formatındaki dosyaları otomatik olarak parse eder:<br /><br />
                            📥 <strong>Dosya Yükle</strong> → 
                            🔍 <strong>Cari Kodu'na göre böl</strong> → 
                            📝 <strong>Regex ile ayıkla</strong> → 
                            💾 <strong>Veritabanına kaydet</strong>
                        </small>
                    </div>

                    <form asp-action="ImportExcel" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-4">
                            <label for="file" class="form-label">
                                <i class="bi bi-file-earmark-spreadsheet me-1"></i>Rapor Dosyası Seçin
                            </label>
                            <input type="file" class="form-control form-control-lg" id="file" name="file" 
                                   accept=".txt,.xlsx,.xls,.csv" required />
                            <div class="form-text">Desteklenen formatlar: .txt, .xlsx, .xls, .csv</div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Geri Dön
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-lightning-charge me-1"></i>Pipeline Çalıştır
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            @if (Model.Statistics != null)
            {
                @await Html.PartialAsync("_BatchStatistics", Model.Statistics)
            }

            @await Html.PartialAsync("_BatchFilters", Model)

            <div class="card shadow-sm">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-clock-history me-2"></i>Geçmiş Yüklemeler
                    </h5>
                    <div>
                        <a asp-action="ExportHistory" 
                           asp-route-format="csv"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-fileNameFilter="@Model.FileNameFilter"
                           asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                           asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                           class="btn btn-sm btn-light me-2">
                            <i class="bi bi-file-earmark-spreadsheet me-1"></i>CSV İndir
                        </a>
                        <a asp-action="ExportHistory" 
                           asp-route-format="excel"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-fileNameFilter="@Model.FileNameFilter"
                           asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                           asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                           class="btn btn-sm btn-light">
                            <i class="bi bi-file-earmark-excel me-1"></i>Excel İndir
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Batches != null && Model.Batches.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>
                                            <a asp-action="ImportExcel" 
                                               asp-route-statusFilter="@Model.StatusFilter"
                                               asp-route-fileNameFilter="@Model.FileNameFilter"
                                               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                                               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                                               asp-route-page="@Model.PageNumber"
                                               asp-route-pageSize="@Model.PageSize"
                                               asp-route-sortBy="BatchID"
                                               asp-route-sortDirection="@(Model.SortBy == "BatchID" && Model.SortDirection == "ASC" ? "DESC" : "ASC")"
                                               class="text-decoration-none text-dark">
                                                Batch ID
                                                @if (Model.SortBy == "BatchID")
                                                {
                                                    <i class="bi bi-arrow-@(Model.SortDirection == "ASC" ? "up" : "down")"></i>
                                                }
                                            </a>
                                        </th>
                                        <th>
                                            <a asp-action="ImportExcel" 
                                               asp-route-statusFilter="@Model.StatusFilter"
                                               asp-route-fileNameFilter="@Model.FileNameFilter"
                                               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                                               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                                               asp-route-page="@Model.PageNumber"
                                               asp-route-pageSize="@Model.PageSize"
                                               asp-route-sortBy="FileName"
                                               asp-route-sortDirection="@(Model.SortBy == "FileName" && Model.SortDirection == "ASC" ? "DESC" : "ASC")"
                                               class="text-decoration-none text-dark">
                                                Dosya Adı
                                                @if (Model.SortBy == "FileName")
                                                {
                                                    <i class="bi bi-arrow-@(Model.SortDirection == "ASC" ? "up" : "down")"></i>
                                                }
                                            </a>
                                        </th>
                                        <th>Dosya Tarihi</th>
                                        <th>
                                            <a asp-action="ImportExcel" 
                                               asp-route-statusFilter="@Model.StatusFilter"
                                               asp-route-fileNameFilter="@Model.FileNameFilter"
                                               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                                               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                                               asp-route-page="@Model.PageNumber"
                                               asp-route-pageSize="@Model.PageSize"
                                               asp-route-sortBy="UploadDate"
                                               asp-route-sortDirection="@(Model.SortBy == "UploadDate" && Model.SortDirection == "ASC" ? "DESC" : "ASC")"
                                               class="text-decoration-none text-dark">
                                                Yükleme Tarihi
                                                @if (Model.SortBy == "UploadDate")
                                                {
                                                    <i class="bi bi-arrow-@(Model.SortDirection == "ASC" ? "up" : "down")"></i>
                                                }
                                            </a>
                                        </th>
                                        <th>
                                            <a asp-action="ImportExcel" 
                                               asp-route-statusFilter="@Model.StatusFilter"
                                               asp-route-fileNameFilter="@Model.FileNameFilter"
                                               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                                               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                                               asp-route-page="@Model.PageNumber"
                                               asp-route-pageSize="@Model.PageSize"
                                               asp-route-sortBy="TotalRecords"
                                               asp-route-sortDirection="@(Model.SortBy == "TotalRecords" && Model.SortDirection == "ASC" ? "DESC" : "ASC")"
                                               class="text-decoration-none text-dark">
                                                Kayıt Sayısı
                                                @if (Model.SortBy == "TotalRecords")
                                                {
                                                    <i class="bi bi-arrow-@(Model.SortDirection == "ASC" ? "up" : "down")"></i>
                                                }
                                            </a>
                                        </th>
                                        <th>Durum</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var batch in Model.Batches)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-action="BatchDetails" asp-route-id="@batch.BatchID" class="text-decoration-none">
                                                    @batch.BatchID
                                                </a>
                                            </td>
                                            <td>@batch.FileName</td>
                                            <td>@batch.FileTimestamp.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>@batch.UploadDate.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>@batch.TotalRecords</td>
                                            <td>
                                                @{
                                                    string badgeClass = batch.Status switch
                                                    {
                                                        "Processed" => "bg-success",
                                                        "Pending" => "bg-warning",
                                                        "Rejected" => "bg-danger",
                                                        _ => "bg-secondary"
                                                    };
                                                }
                                                <span class="badge @badgeClass">@batch.Status</span>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a asp-action="BatchDetails" asp-route-id="@batch.BatchID" 
                                                       class="btn btn-outline-primary" title="Detaylar">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    @if (batch.Status == "Pending")
                                                    {
                                                        <form asp-action="UpdateBatchStatus" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="batchId" value="@batch.BatchID" />
                                                            <input type="hidden" name="status" value="Rejected" />
                                                            <button type="submit" class="btn btn-outline-warning" 
                                                                    title="İptal Et" 
                                                                    onclick="return confirm('Bu batch\'i iptal etmek istediğinize emin misiniz?');">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    <form asp-action="DeleteBatch" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="batchId" value="@batch.BatchID" />
                                                        <button type="submit" class="btn btn-outline-danger" 
                                                                title="Sil" 
                                                                onclick="return confirm('Bu batch\'i silmek istediğinize emin misiniz? Bu işlem geri alınamaz!');">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div>
                                <span class="text-muted">
                                    Toplam <strong>@Model.TotalRecords</strong> kayıt bulundu.
                                    Sayfa <strong>@Model.PageNumber</strong> / <strong>@Model.TotalPages</strong>
                                </span>
                                <select name="pageSize" class="form-select form-select-sm d-inline-block ms-2" style="width: auto;" 
                                        onchange="location.href='@Url.Action("ImportExcel", new { statusFilter = Model.StatusFilter, fileNameFilter = Model.FileNameFilter, startDate = Model.StartDate?.ToString("yyyy-MM-dd"), endDate = Model.EndDate?.ToString("yyyy-MM-dd"), page = 1, pageSize = "__VALUE__", sortBy = Model.SortBy, sortDirection = Model.SortDirection })'.replace('__VALUE__', this.value)">
                                    @if (Model.PageSize == 10)
                                    {
                                        <option value="10" selected>10</option>
                                    }
                                    else
                                    {
                                        <option value="10">10</option>
                                    }
                                    @if (Model.PageSize == 25)
                                    {
                                        <option value="25" selected>25</option>
                                    }
                                    else
                                    {
                                        <option value="25">25</option>
                                    }
                                    @if (Model.PageSize == 50)
                                    {
                                        <option value="50" selected>50</option>
                                    }
                                    else
                                    {
                                        <option value="50">50</option>
                                    }
                                    @if (Model.PageSize == 100)
                                    {
                                        <option value="100" selected>100</option>
                                    }
                                    else
                                    {
                                        <option value="100">100</option>
                                    }
                                </select>
                            </div>
                            <nav>
                                <ul class="pagination pagination-sm mb-0">
                                    @if (Model.PageNumber > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" 
                                               asp-action="ImportExcel"
                                               asp-route-statusFilter="@Model.StatusFilter"
                                               asp-route-fileNameFilter="@Model.FileNameFilter"
                                               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                                               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                                               asp-route-page="@(Model.PageNumber - 1)"
                                               asp-route-pageSize="@Model.PageSize"
                                               asp-route-sortBy="@Model.SortBy"
                                               asp-route-sortDirection="@Model.SortDirection">
                                                Önceki
                                            </a>
                                        </li>
                                    }
                                    @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                                    {
                                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                            <a class="page-link" 
                                               asp-action="ImportExcel"
                                               asp-route-statusFilter="@Model.StatusFilter"
                                               asp-route-fileNameFilter="@Model.FileNameFilter"
                                               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                                               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                                               asp-route-page="@i"
                                               asp-route-pageSize="@Model.PageSize"
                                               asp-route-sortBy="@Model.SortBy"
                                               asp-route-sortDirection="@Model.SortDirection">
                                                @i
                                            </a>
                                        </li>
                                    }
                                    @if (Model.PageNumber < Model.TotalPages)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" 
                                               asp-action="ImportExcel"
                                               asp-route-statusFilter="@Model.StatusFilter"
                                               asp-route-fileNameFilter="@Model.FileNameFilter"
                                               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                                               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                                               asp-route-page="@(Model.PageNumber + 1)"
                                               asp-route-pageSize="@Model.PageSize"
                                               asp-route-sortBy="@Model.SortBy"
                                               asp-route-sortDirection="@Model.SortDirection">
                                                Sonraki
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="bi bi-info-circle me-2"></i>Henüz yüklenmiş dosya bulunmamaktadır.
                        </div>
                    }
                </div>
            </div>

            <div class="card mt-4 border-primary">
                <div class="card-header bg-light">
                    <i class="bi bi-info-circle me-2"></i>Beklenen Dosya Formatı
                </div>
                <div class="card-body small">
                    <p>Dosya içinde her müşteri bloğu şu şekilde başlamalıdır:</p>
                    <pre class="bg-light p-2 rounded mb-0"><code>Cari Kodu: 120-001-0001
Cari Adı: ABC TİCARET LTD. ŞTİ.
Telefon: 0212 555 1234
Adres: İstanbul, Türkiye
Borç Bakiye: 15.750,00
Alacak Bakiye: 0,00</code></pre>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .table th a:hover {
        text-decoration: underline !important;
    }
    .table td {
        vertical-align: middle;
    }
</style>
