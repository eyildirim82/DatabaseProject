@model IEnumerable<DatabaseProject.Models.Customer>

@{
    ViewData["Title"] = "Müşteri Listesi";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-people-fill me-2"></i>Müşteri Listesi
        </h2>
        <div>
            @{
                var roleId = Context.Session.GetInt32("RoleID");
                bool isAdminOrAccountant = roleId == 1 || roleId == 2;
            }
            <a asp-action="ExportToExcel" class="btn btn-success me-2">
                <i class="bi bi-file-earmark-excel me-1"></i>Excel İndir
            </a>
            <a asp-action="ExportToPdf" class="btn btn-danger me-2">
                <i class="bi bi-file-earmark-pdf me-1"></i>PDF İndir
            </a>
            @if (isAdminOrAccountant)
            {
                <a asp-action="ImportExcel" class="btn btn-primary">
                    <i class="bi bi-file-earmark-arrow-up me-1"></i>Excel Yükle
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div data-tempdata-success style="display: none;">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div data-tempdata-error style="display: none;">@TempData["ErrorMessage"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Hesap Kodu</th>
                            <th>Firma Adı</th>
                            <th>Vergi No</th>
                            <th>Telefon</th>
                            <th class="text-end">Risk Limiti</th>
                            <th class="text-end">Mevcut Bakiye</th>
                            <th class="text-end">Kullanılabilir Risk</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var customer in Model)
                            {
                                <tr>
                                    <td><code>@customer.AccountCode</code></td>
                                    <td>
                                        <strong>
                                            <a asp-action="Details" asp-route-id="@customer.CustomerID" class="text-decoration-none">
                                                @customer.CompanyName
                                            </a>
                                        </strong>
                                    </td>
                                    <td>@(customer.TaxID ?? "-")</td>
                                    <td>@(customer.PhoneNumber ?? "-")</td>
                                    <td class="text-end">@customer.RiskLimit.ToString("N2") ₺</td>
                                    <td class="text-end">@customer.CurrentBalance.ToString("N2") ₺</td>
                                    <td class="text-end">
                                        @if (customer.AvailableRisk < 0)
                                        {
                                            <span class="badge bg-danger">@customer.AvailableRisk.ToString("N2") ₺</span>
                                        }
                                        else if (customer.AvailableRisk < customer.RiskLimit * 0.1m)
                                        {
                                            <span class="badge bg-warning text-dark">@customer.AvailableRisk.ToString("N2") ₺</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@customer.AvailableRisk.ToString("N2") ₺</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@customer.CustomerID" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i> Detay
                                            </a>
                                            @if (isAdminOrAccountant)
                                            {
                                                <a asp-action="Edit" asp-route-id="@customer.CustomerID" class="btn btn-sm btn-outline-warning">
                                                    <i class="bi bi-pencil"></i> Düzenle
                                                </a>
                                                <form asp-action="Delete" asp-route-id="@customer.CustomerID" method="post" class="d-inline" onsubmit="return confirm('Bu müşteriyi silmek istediğinize emin misiniz? İşlem geri alınamaz.');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-trash"></i> Sil
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox display-6 d-block mb-2"></i>
                                    Henüz müşteri kaydı bulunmuyor.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-muted">
            Toplam <strong>@(Model?.Count() ?? 0)</strong> müşteri
        </div>
    </div>
</div>

<style>
    .table th { font-weight: 600; white-space: nowrap; }
    .table td { vertical-align: middle; }
    code { background-color: #e9ecef; padding: 2px 6px; border-radius: 4px; color: #495057; }
</style>
