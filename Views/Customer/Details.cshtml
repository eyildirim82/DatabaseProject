@{
    ViewData["Title"] = "Müşteri Detayları";
    var customer = ViewBag.Customer as DatabaseProject.Models.Customer;
    var notes = ViewBag.Notes as List<DatabaseProject.Models.CollectionNote> ?? new List<DatabaseProject.Models.CollectionNote>();
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">
                    <i class="bi bi-person-badge me-2"></i>Müşteri Detayları
                </h2>
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary me-2">
                        <i class="bi bi-arrow-left me-1"></i>Geri Dön
                    </a>
                    <a asp-controller="CollectionNote" asp-action="Create" asp-route-customerId="@customer.CustomerID" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>Yeni Not Ekle
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (customer != null)
    {
        <!-- Müşteri Bilgileri -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-info-circle me-2"></i>Müşteri Bilgileri
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <strong>Hesap Kodu:</strong> <code>@customer.AccountCode</code>
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Firma Adı:</strong> @customer.CompanyName
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Vergi No:</strong> @(customer.TaxID ?? "-")
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Vergi Dairesi:</strong> @(customer.TaxOffice ?? "-")
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Telefon:</strong> @(customer.PhoneNumber ?? "-")
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Adres:</strong> @(customer.Address ?? "-")
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-md-3">
                        <div class="card border-primary">
                            <div class="card-body text-center">
                                <h6 class="text-muted mb-2">Risk Limiti</h6>
                                <h4 class="mb-0 text-primary">@customer.RiskLimit.ToString("N2") ₺</h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-info">
                            <div class="card-body text-center">
                                <h6 class="text-muted mb-2">Mevcut Bakiye</h6>
                                <h4 class="mb-0 text-info">@customer.CurrentBalance.ToString("N2") ₺</h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card @(customer.AvailableRisk < 0 ? "border-danger" : customer.AvailableRisk < customer.RiskLimit * 0.1m ? "border-warning" : "border-success")">
                            <div class="card-body text-center">
                                <h6 class="text-muted mb-2">Kullanılabilir Risk</h6>
                                <h4 class="mb-0 @(customer.AvailableRisk < 0 ? "text-danger" : customer.AvailableRisk < customer.RiskLimit * 0.1m ? "text-warning" : "text-success")">
                                    @customer.AvailableRisk.ToString("N2") ₺
                                </h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-secondary">
                            <div class="card-body text-center">
                                <h6 class="text-muted mb-2">Risk Durumu</h6>
                                <h4 class="mb-0">
                                    @if (customer.AvailableRisk < 0)
                                    {
                                        <span class="badge bg-danger">Limit Aşıldı</span>
                                    }
                                    else if (customer.AvailableRisk < customer.RiskLimit * 0.1m)
                                    {
                                        <span class="badge bg-warning text-dark">Kritik</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Güvenli</span>
                                    }
                                </h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CRM Notları -->
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">
                    <i class="bi bi-sticky me-2"></i>CRM Notları (@notes.Count)
                </h5>
            </div>
            <div class="card-body">
                @if (notes.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Tarih</th>
                                    <th>Not</th>
                                    <th>Vaade Tarihi</th>
                                    <th>Yazan</th>
                                    <th>İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var note in notes)
                                {
                                    <tr>
                                        <td>@note.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>
                                            <div style="max-width: 500px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@note.NoteText">
                                                @note.NoteText
                                            </div>
                                        </td>
                                        <td>
                                            @if (note.PromiseDate.HasValue)
                                            {
                                                <span class="badge bg-info">@note.PromiseDate.Value.ToString("dd.MM.yyyy")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>@note.FullName</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-controller="CollectionNote" asp-action="Edit" asp-route-id="@note.NoteID" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil"></i> Düzenle
                                                </a>
                                                <form asp-controller="CollectionNote" asp-action="Delete" asp-route-id="@note.NoteID" method="post" class="d-inline" onsubmit="return confirm('Bu notu silmek istediğinize emin misiniz?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-trash"></i> Sil
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle me-2"></i>Bu müşteri için henüz not kaydı bulunmamaktadır.
                        <a asp-controller="CollectionNote" asp-action="Create" asp-route-customerId="@customer.CustomerID" class="alert-link ms-2">İlk notu ekleyin</a>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-circle me-2"></i>Müşteri bilgileri yüklenemedi.
        </div>
    }
</div>

<style>
    .table th { font-weight: 600; white-space: nowrap; }
    .table td { vertical-align: middle; }
    code { background-color: #e9ecef; padding: 2px 6px; border-radius: 4px; color: #495057; }
</style>
