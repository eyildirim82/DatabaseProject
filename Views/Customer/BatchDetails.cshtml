@model List<DatabaseProject.Models.ImportDetail>
@{
    ViewData["Title"] = "Batch Detayları";
    var batch = ViewBag.Batch as DatabaseProject.Models.ImportBatch;
}

<div class="container-fluid">
    @if (TempData["ErrorMessage"] != null)
    {
        <div data-tempdata-error style="display: none;">@TempData["ErrorMessage"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-file-earmark-text me-2"></i>Batch Detayları
        </h2>
        <div>
            <a asp-action="ExportBatchDetails" asp-route-id="@batch.BatchID" asp-route-format="excel" class="btn btn-outline-primary me-2">
                <i class="bi bi-file-earmark-excel me-1"></i>Excel İndir
            </a>
            <a asp-action="ExportBatchDetails" asp-route-id="@batch.BatchID" asp-route-format="csv" class="btn btn-outline-info me-2">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i>CSV İndir
            </a>
            <a asp-action="ImportExcel" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Geri Dön
            </a>
        </div>
    </div>

    @if (batch != null)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Batch Bilgileri</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <strong>Batch ID:</strong> @batch.BatchID
                    </div>
                    <div class="col-md-3">
                        <strong>Dosya Adı:</strong> @batch.FileName
                    </div>
                    <div class="col-md-3">
                        <strong>Dosya Tarihi:</strong> @batch.FileTimestamp.ToString("dd.MM.yyyy HH:mm")
                    </div>
                    <div class="col-md-3">
                        <strong>Yükleme Tarihi:</strong> @batch.UploadDate.ToString("dd.MM.yyyy HH:mm")
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-3">
                        <strong>Kayıt Sayısı:</strong> @batch.TotalRecords
                    </div>
                    <div class="col-md-3">
                        <strong>Durum:</strong>
                        @{
                            string badgeClass = batch.Status switch
                            {
                                "Processed" => "bg-success",
                                "Pending" => "bg-warning",
                                "Rejected" => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@batch.Status</span>
                    </div>
                </div>
            </div>
        </div>
    }

    @{
        var errorDetails = Model?.Where(d => !string.IsNullOrEmpty(d.ErrorMessage)).ToList() ?? new List<DatabaseProject.Models.ImportDetail>();
        var successDetails = Model?.Where(d => string.IsNullOrEmpty(d.ErrorMessage)).ToList() ?? new List<DatabaseProject.Models.ImportDetail>();
    }

    @if (errorDetails.Any())
    {
        <!-- Hata Özeti -->
        <div class="card shadow-sm mb-4 border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>Hata Özeti
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="card border-danger">
                            <div class="card-body text-center">
                                <h6 class="text-muted mb-2">Hatalı Satır Sayısı</h6>
                                <h3 class="mb-0 text-danger">@errorDetails.Count</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-success">
                            <div class="card-body text-center">
                                <h6 class="text-muted mb-2">Başarılı Satır Sayısı</h6>
                                <h3 class="mb-0 text-success">@successDetails.Count</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-info">
                            <div class="card-body text-center">
                                <h6 class="text-muted mb-2">Toplam Satır</h6>
                                <h3 class="mb-0 text-info">@Model.Count</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hatalı Satırlar -->
        <div class="card shadow-sm mb-4 border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">
                    <i class="bi bi-x-circle me-2"></i>Hatalı Satırlar (@errorDetails.Count)
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Hesap Kodu</th>
                                <th>Tespit Edilen İsim</th>
                                <th>Hata Mesajı</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in errorDetails)
                            {
                                <tr class="table-danger">
                                    <td><code>@detail.AccountCode</code></td>
                                    <td>@detail.DetectedName</td>
                                    <td>
                                        <span class="badge bg-danger">@detail.ErrorMessage</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Detay Kayıtları -->
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">
                <i class="bi bi-list-ul me-2"></i>Detay Kayıtları (@Model.Count)
                @if (errorDetails.Any())
                {
                    <span class="badge bg-danger ms-2">@errorDetails.Count Hatalı</span>
                }
            </h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Hesap Kodu</th>
                                <th>Tespit Edilen İsim</th>
                                <th class="text-end">Excel Bakiyesi</th>
                                <th class="text-end">Sistem Bakiyesi</th>
                                <th class="text-end">Fark</th>
                                @if (errorDetails.Any())
                                {
                                    <th>Hata</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in Model)
                            {
                                <tr class="@(!string.IsNullOrEmpty(detail.ErrorMessage) ? "table-danger" : "")">
                                    <td><code>@detail.AccountCode</code></td>
                                    <td>@detail.DetectedName</td>
                                    <td class="text-end">@detail.ExcelBalance.ToString("N2") ₺</td>
                                    <td class="text-end">@detail.SystemBalanceAtTime.ToString("N2") ₺</td>
                                    <td class="text-end">
                                        @{
                                            var diff = detail.BalanceDifference;
                                            string diffClass = diff == 0 ? "text-success" : (diff > 0 ? "text-danger" : "text-info");
                                        }
                                        <span class="@diffClass">
                                            @(diff > 0 ? "+" : "")@diff.ToString("N2") ₺
                                        </span>
                                    </td>
                                    @if (errorDetails.Any())
                                    {
                                        <td>
                                            @if (!string.IsNullOrEmpty(detail.ErrorMessage))
                                            {
                                                <span class="badge bg-danger" title="@detail.ErrorMessage">@detail.ErrorMessage</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Başarılı</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-secondary">
                                <td colspan="@(errorDetails.Any() ? "2" : "2")"><strong>Toplam</strong></td>
                                <td class="text-end"><strong>@Model.Sum(d => d.ExcelBalance).ToString("N2") ₺</strong></td>
                                <td class="text-end"><strong>@Model.Sum(d => d.SystemBalanceAtTime).ToString("N2") ₺</strong></td>
                                <td class="text-end">
                                    @{
                                        var totalDiff = Model.Sum(d => d.BalanceDifference);
                                        string totalDiffClass = totalDiff == 0 ? "text-success" : (totalDiff > 0 ? "text-danger" : "text-info");
                                    }
                                    <strong class="@totalDiffClass">
                                        @(totalDiff > 0 ? "+" : "")@totalDiff.ToString("N2") ₺
                                    </strong>
                                </td>
                                @if (errorDetails.Any())
                                {
                                    <td></td>
                                }
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    <i class="bi bi-info-circle me-2"></i>Bu batch için detay kaydı bulunmamaktadır.
                </div>
            }
        </div>
    </div>
</div>

<style>
    .table th { font-weight: 600; white-space: nowrap; }
    .table td { vertical-align: middle; }
    code { background-color: #e9ecef; padding: 2px 6px; border-radius: 4px; color: #495057; }
</style>
