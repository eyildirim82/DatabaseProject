@model DatabaseProject.Models.AuditLogViewModel
@{
    ViewData["Title"] = "Audit Log";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-3">
                <i class="bi bi-journal-text me-2"></i>Audit Log (Sistem Günlükleri)
            </h2>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filtreleme Formu -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">
                <i class="bi bi-funnel me-2"></i>Filtreleme
            </h5>
        </div>
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label for="tableNameFilter" class="form-label">Tablo Adı</label>
                        <select class="form-select" id="tableNameFilter" name="tableNameFilter">
                            <option value="">Tümü</option>
                            @if (Model?.AvailableTableNames != null)
                            {
                                @foreach (var tableName in Model.AvailableTableNames)
                                {
                                    <option value="@tableName" selected="@(Model.TableNameFilter == tableName)">@tableName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="operationTypeFilter" class="form-label">İşlem Tipi</label>
                        <select class="form-select" id="operationTypeFilter" name="operationTypeFilter">
                            <option value="">Tümü</option>
                            @if (Model?.AvailableOperationTypes != null)
                            {
                                @foreach (var opType in Model.AvailableOperationTypes)
                                {
                                    <option value="@opType" selected="@(Model.OperationTypeFilter == opType)">@opType</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label for="startDate" class="form-label">Başlangıç Tarihi</label>
                        <input type="date" class="form-control" id="startDate" name="startDate" 
                               value="@(Model?.StartDate?.ToString("yyyy-MM-dd"))">
                    </div>
                    <div class="col-md-2">
                        <label for="endDate" class="form-label">Bitiş Tarihi</label>
                        <input type="date" class="form-control" id="endDate" name="endDate" 
                               value="@(Model?.EndDate?.ToString("yyyy-MM-dd"))">
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2 w-100">
                            <i class="bi bi-search me-1"></i>Filtrele
                        </button>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-12">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-x-circle me-1"></i>Filtreleri Temizle
                        </a>
                    </div>
                </div>
                <input type="hidden" name="page" value="1" />
                <input type="hidden" name="pageSize" value="@(Model?.PageSize ?? 20)" />
                <input type="hidden" name="sortBy" value="@(Model?.SortBy ?? "LogDate")" />
                <input type="hidden" name="sortDirection" value="@(Model?.SortDirection ?? "DESC")" />
            </form>
        </div>
    </div>

    <!-- Audit Log Listesi -->
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-list-ul me-2"></i>Log Kayıtları
            </h5>
            <span class="badge bg-light text-dark">Toplam: @(Model?.TotalRecords ?? 0) kayıt</span>
        </div>
        <div class="card-body">
            @if (Model.Logs.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-sm">
                        <thead>
                            <tr>
                                <th>
                                    <a href="?tableNameFilter=@(Model?.TableNameFilter ?? "")&operationTypeFilter=@(Model?.OperationTypeFilter ?? "")&startDate=@(Model?.StartDate?.ToString("yyyy-MM-dd") ?? "")&endDate=@(Model?.EndDate?.ToString("yyyy-MM-dd") ?? "")&page=@(Model?.PageNumber ?? 1)&pageSize=@(Model?.PageSize ?? 20)&sortBy=LogDate&sortDirection=@((Model?.SortBy == "LogDate" && Model?.SortDirection == "ASC") ? "DESC" : "ASC")" 
                                       class="text-decoration-none text-white">
                                        Tarih
                                        @if (Model?.SortBy == "LogDate")
                                        {
                                            <i class="bi bi-arrow-@(Model.SortDirection == "ASC" ? "up" : "down")"></i>
                                        }
                                    </a>
                                </th>
                                <th>
                                    <a href="?tableNameFilter=@(Model?.TableNameFilter ?? "")&operationTypeFilter=@(Model?.OperationTypeFilter ?? "")&startDate=@(Model?.StartDate?.ToString("yyyy-MM-dd") ?? "")&endDate=@(Model?.EndDate?.ToString("yyyy-MM-dd") ?? "")&page=@(Model?.PageNumber ?? 1)&pageSize=@(Model?.PageSize ?? 20)&sortBy=TableName&sortDirection=@((Model?.SortBy == "TableName" && Model?.SortDirection == "ASC") ? "DESC" : "ASC")" 
                                       class="text-decoration-none text-white">
                                        Tablo
                                        @if (Model?.SortBy == "TableName")
                                        {
                                            <i class="bi bi-arrow-@(Model.SortDirection == "ASC" ? "up" : "down")"></i>
                                        }
                                    </a>
                                </th>
                                <th>Kayıt ID</th>
                                <th>
                                    <a href="?tableNameFilter=@(Model?.TableNameFilter ?? "")&operationTypeFilter=@(Model?.OperationTypeFilter ?? "")&startDate=@(Model?.StartDate?.ToString("yyyy-MM-dd") ?? "")&endDate=@(Model?.EndDate?.ToString("yyyy-MM-dd") ?? "")&page=@(Model?.PageNumber ?? 1)&pageSize=@(Model?.PageSize ?? 20)&sortBy=OperationType&sortDirection=@((Model?.SortBy == "OperationType" && Model?.SortDirection == "ASC") ? "DESC" : "ASC")" 
                                       class="text-decoration-none text-white">
                                        İşlem
                                        @if (Model?.SortBy == "OperationType")
                                        {
                                            <i class="bi bi-arrow-@(Model.SortDirection == "ASC" ? "up" : "down")"></i>
                                        }
                                    </a>
                                </th>
                                <th>Eski Değer</th>
                                <th>Yeni Değer</th>
                                <th>Değiştiren</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.Logs)
                            {
                                <tr>
                                    <td>@log.LogDate.ToString("dd.MM.yyyy HH:mm:ss")</td>
                                    <td><span class="badge bg-secondary">@log.TableName</span></td>
                                    <td>@log.RecordID</td>
                                    <td>
                                        @if (log.OperationType == "DELETE")
                                        {
                                            <span class="badge bg-danger">@log.OperationType</span>
                                        }
                                        else if (log.OperationType == "UPDATE")
                                        {
                                            <span class="badge bg-warning">@log.OperationType</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@log.OperationType</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(log.OldValue))
                                        {
                                            <small class="text-muted">@(log.OldValue.Length > 50 ? log.OldValue.Substring(0, 50) + "..." : log.OldValue)</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(log.NewValue))
                                        {
                                            <small class="text-success">@(log.NewValue.Length > 50 ? log.NewValue.Substring(0, 50) + "..." : log.NewValue)</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>@(log.ChangedBy?.ToString() ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Sayfalama -->
                @if (Model?.TotalPages > 1)
                {
                    <nav aria-label="Sayfa navigasyonu">
                        <ul class="pagination justify-content-center mt-3">
                            @if (Model?.PageNumber > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?tableNameFilter=@(Model?.TableNameFilter ?? "")&operationTypeFilter=@(Model?.OperationTypeFilter ?? "")&startDate=@(Model?.StartDate?.ToString("yyyy-MM-dd") ?? "")&endDate=@(Model?.EndDate?.ToString("yyyy-MM-dd") ?? "")&page=@((Model?.PageNumber ?? 1) - 1)&pageSize=@(Model?.PageSize ?? 20)&sortBy=@(Model?.SortBy ?? "LogDate")&sortDirection=@(Model?.SortDirection ?? "DESC")">
                                        Önceki
                                    </a>
                                </li>
                            }

                            @for (int i = Math.Max(1, (Model?.PageNumber ?? 1) - 2); i <= Math.Min(Model?.TotalPages ?? 1, (Model?.PageNumber ?? 1) + 2); i++)
                            {
                                <li class="page-item @(i == (Model?.PageNumber ?? 1) ? "active" : "")">
                                    <a class="page-link" href="?tableNameFilter=@(Model?.TableNameFilter ?? "")&operationTypeFilter=@(Model?.OperationTypeFilter ?? "")&startDate=@(Model?.StartDate?.ToString("yyyy-MM-dd") ?? "")&endDate=@(Model?.EndDate?.ToString("yyyy-MM-dd") ?? "")&page=@i&pageSize=@(Model?.PageSize ?? 20)&sortBy=@(Model?.SortBy ?? "LogDate")&sortDirection=@(Model?.SortDirection ?? "DESC")">
                                        @i
                                    </a>
                                </li>
                            }

                            @if ((Model?.PageNumber ?? 1) < (Model?.TotalPages ?? 1))
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?tableNameFilter=@(Model?.TableNameFilter ?? "")&operationTypeFilter=@(Model?.OperationTypeFilter ?? "")&startDate=@(Model?.StartDate?.ToString("yyyy-MM-dd") ?? "")&endDate=@(Model?.EndDate?.ToString("yyyy-MM-dd") ?? "")&page=@((Model?.PageNumber ?? 1) + 1)&pageSize=@(Model?.PageSize ?? 20)&sortBy=@(Model?.SortBy ?? "LogDate")&sortDirection=@(Model?.SortDirection ?? "DESC")">
                                        Sonraki
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>Filtre kriterlerine uygun log kaydı bulunamadı.
                </div>
            }
        </div>
    </div>
</div>
