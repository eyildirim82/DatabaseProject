@model DatabaseProject.Models.CollectionNoteViewModel
@{
    ViewData["Title"] = "CRM Notları";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">
                    <i class="bi bi-sticky me-2"></i>CRM Notları
                </h2>
                @if (Model.CustomerID.HasValue)
                {
                    <a asp-action="Create" asp-route-customerId="@Model.CustomerID" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>Yeni Not Ekle
                    </a>
                }
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div data-tempdata-success style="display: none;">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div data-tempdata-error style="display: none;">@TempData["ErrorMessage"]</div>
    }

    <!-- Filtreleme -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="customerId" class="form-label">Müşteri Filtresi</label>
                        <select class="form-select" id="customerId" name="customerId">
                            <option value="">Tüm Müşteriler</option>
                            @if (Model.AvailableCustomers != null)
                            {
                                @foreach (var customer in Model.AvailableCustomers)
                                {
                                    <option value="@customer.CustomerID" selected="@(Model.CustomerID == customer.CustomerID)">@customer.CompanyName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="bi bi-funnel me-1"></i>Filtrele
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i>Temizle
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Not Listesi -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-list-ul me-2"></i>Not Listesi (@Model.CollectionNotes.Count)
                @if (Model.CustomerID.HasValue && !string.IsNullOrEmpty(Model.CustomerName))
                {
                    <span class="ms-2">- @Model.CustomerName</span>
                }
            </h5>
        </div>
        <div class="card-body">
            @if (Model.CollectionNotes.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Tarih</th>
                                <th>Müşteri</th>
                                <th>Not</th>
                                <th>Vaade Tarihi</th>
                                <th>Yazan</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var note in Model.CollectionNotes)
                            {
                                <tr>
                                    <td>@note.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        <a asp-controller="Customer" asp-action="Details" asp-route-id="@note.CustomerID">
                                            @note.CompanyName
                                        </a>
                                    </td>
                                    <td>
                                        <div style="max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@note.NoteText">
                                            @note.NoteText
                                        </div>
                                    </td>
                                    <td>
                                        @if (note.PromiseDate.HasValue)
                                        {
                                            <span class="badge bg-info">@note.PromiseDate.Value.ToString("dd.MM.yyyy")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>@note.FullName</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@note.NoteID" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil"></i> Düzenle
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@note.NoteID" method="post" class="d-inline" onsubmit="return confirm('Bu notu silmek istediğinize emin misiniz?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i> Sil
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>Henüz not kaydı bulunmamaktadır.
                </div>
            }
        </div>
    </div>
</div>

<style>
    .table th { font-weight: 600; white-space: nowrap; }
    .table td { vertical-align: middle; }
</style>
