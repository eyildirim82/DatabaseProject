@model DatabaseProject.Models.ChequeViewModel
@{
    ViewData["Title"] = "Çek Yönetimi";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">
                    <i class="bi bi-receipt-cutoff me-2"></i>Çek Yönetimi
                </h2>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>Yeni Çek Ekle
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div data-tempdata-success style="display: none;">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div data-tempdata-error style="display: none;">@TempData["ErrorMessage"]</div>
    }

    <!-- Filtreleme -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="statusFilter" class="form-label">Durum Filtresi</label>
                        <select class="form-select" id="statusFilter" name="statusFilter">
                            <option value="">Tümü</option>
                            @foreach (var status in Model.AvailableStatuses)
                            {
                                <option value="@status" selected="@(Model.StatusFilter == status)">@status</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="bi bi-funnel me-1"></i>Filtrele
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i>Temizle
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Çek Listesi -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-list-ul me-2"></i>Çek Listesi (@Model.Cheques.Count)
            </h5>
        </div>
        <div class="card-body">
            @if (Model.Cheques.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Çek ID</th>
                                <th>Müşteri</th>
                                <th>Banka</th>
                                <th>Çek No</th>
                                <th>Tutar</th>
                                <th>Vade Tarihi</th>
                                <th>Durum</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cheque in Model.Cheques)
                            {
                                <tr>
                                    <td>@cheque.ChequeID</td>
                                    <td>@cheque.CompanyName</td>
                                    <td>@cheque.BankName</td>
                                    <td>@(cheque.ChequeNumber ?? "-")</td>
                                    <td>@cheque.Amount.ToString("N2") ₺</td>
                                    <td>@cheque.DueDate.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        @if (cheque.Status == "Portfolio")
                                        {
                                            <span class="badge bg-info">@cheque.Status</span>
                                        }
                                        else if (cheque.Status == "Collected")
                                        {
                                            <span class="badge bg-success">@cheque.Status</span>
                                        }
                                        else if (cheque.Status == "Bounced")
                                        {
                                            <span class="badge bg-danger">@cheque.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">@cheque.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            @if (cheque.Status == "Portfolio")
                                            {
                                                <form asp-action="CollectCheque" asp-route-id="@cheque.ChequeID" method="post" class="d-inline" onsubmit="return confirm('Bu çeki tahsil etmek istediğinize emin misiniz?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success">
                                                        <i class="bi bi-check-circle"></i> Tahsil Et
                                                    </button>
                                                </form>
                                                <form asp-action="MarkBounced" asp-route-id="@cheque.ChequeID" method="post" class="d-inline" onsubmit="return confirm('Bu çeki karşılıksız olarak işaretlemek istediğinize emin misiniz?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger">
                                                        <i class="bi bi-x-circle"></i> Karşılıksız
                                                    </button>
                                                </form>
                                                <form asp-action="ReturnCheque" asp-route-id="@cheque.ChequeID" method="post" class="d-inline" onsubmit="return confirm('Bu çeki iade etmek istediğinize emin misiniz?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-warning">
                                                        <i class="bi bi-arrow-return-left"></i> İade
                                                    </button>
                                                </form>
                                            }
                                            <a asp-action="Edit" asp-route-id="@cheque.ChequeID" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil"></i> Düzenle
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@cheque.ChequeID" method="post" class="d-inline" onsubmit="return confirm('Bu çeki silmek istediğinize emin misiniz?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i> Sil
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>Henüz çek kaydı bulunmamaktadır.
                </div>
            }
        </div>
    </div>
</div>
